#include <iostream>
using namespace std;

double squared_sum(double a, double b) {
    double summa = a + b;
    return summa * summa;
}


int main() {
    setlocale(0, "Russian");
    cout << "Введите числа" << endl;
    int a, b;
    cin >> a;
    cin >> b;
    cout << squared_sum(a, b) << "\n";
    cout << squared_sum(a, -b) << "\n";
    return 0;
}

