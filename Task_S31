#include <iostream>
#include <clocale>
#include <fstream>
#include <string>

int main() {
    setlocale(0, "Russian");

    int A;
    std::cout << "Введите номер строки: ";
    std::cin >> A;

    std::ifstream fin("output.txt");

    std::string line;
    int linenum = 0;

    while (std::getline(fin, line)) {
        if (linenum == A) {
            std::cout << "Строка " << A << ": " << line << std::endl;
            break;
        }
        linenum++;
    }

    fin.close();
    return 0;
}

