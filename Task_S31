#include <iostream>
#include <string>

using namespace std;

int main() {
    setlocale(0, "Russian");
    string nazvaniya[10] = {
        "ноль", "один", "два", "три", "четыре",
        "пять", "шесть", "семь", "восемь", "девять"
    };

    cout << "Введи число от 0 до 9: ";
    int number;
    cin >> number;

    if (number >= 0 && number <= 9) {
        cout << "Это " << nazvaniya[number] << endl;
    } else {
        cout << "Ошибка" << endl;
    }

    return 0;
}
