#include <iostream>
#include <string>   // string
using namespace std;


void reverse(string text) {
    for (int i = text.length() - 1; i >= 0; i--) {
        cout << text[i];
    }
    cout << endl;
}

int main() {
    setlocale(0, "Russian");
    string text;
    cin >> text;
    reverse(text);
    return 0;
}
