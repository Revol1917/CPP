#include <iostream>
using namespace std;

int main() {
    cout << "\t";
    for (int i = 1; i <= 10; i++) {
        cout << i << "\t";
    }
    cout << endl;

    for (int stroka = 1; stroka <= 10; stroka++) {
        cout << stroka << "\t";
        for (int stolbec = 1; stolbec <= 10; stolbec++) {
            cout << stroka * stolbec << "\t";
        }
        cout << endl;
    }

    return 0;
}
